# Copy to `.env` and adjust. `.env` is gitignored.

# LLM provider: "mock" (default, no key required) or "openai".
LLM_PROVIDER=mock

# OpenAI configuration. Only consulted when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=30

# Web exposure. Browser visits http://localhost:${WEB_PORT}
WEB_PORT=8080

# CORS origins for direct backend calls (comma-separated).
# When using the Nginx reverse-proxy in compose, the browser only ever talks
# to the web container, so this rarely needs to change.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
